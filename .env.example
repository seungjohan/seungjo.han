# Admin Authentication
# These are read only by the serverless functions in /api — never prefix
# them with VITE_, or they will be bundled into the public client JS.
#
# Set the real values in Vercel: Project Settings → Environment Variables.
# For local development with `vercel dev`, run `vercel env pull` to fetch them
# into .env.local (gitignored).

# The admin panel password.
ADMIN_PASSWORD=

# Random secret used to sign admin session cookies. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
